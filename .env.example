# ==========================================
# upload 配置文件 / Configuration file
# ==========================================

# HTTP 监听地址，默认 :8080。
# HTTP listen address. Default: :8080.
ADDR=:8080

# MD5 签名密钥【必填】。
# MD5 signing secret [required].
#
# 上传签名 / Upload signature:
#   RESSIGN = md5(MD5_KEY + RESTIME)
#   RESPATH 不参与签名，只用于指定上传目录。
#   RESPATH does not participate in signing; it only selects the upload directory.
#
# 静态资源签名 / Resource signature:
#   RESSIGN = md5(MD5_KEY + RESTIME)
#
# 请修改为随机且足够长的密钥。
# Use a random and sufficiently long secret.
MD5_KEY=请修改为你的密钥

# RESTIME 允许的时间误差，单位：秒。默认 300 秒。
# Allowed RESTIME clock skew in seconds. Default: 300.
# RESTIME 必须使用 Unix 秒级时间戳（通常 10 位），例如 1786660000。
# RESTIME must be a Unix timestamp in seconds (normally 10 digits), e.g. 1786660000.
# 不使用毫秒时间戳（13 位）。/ Do not use Unix milliseconds (13 digits).
TIME_EXPIRE=300

# 允许上传的文件扩展名，英文逗号分隔。
# Allowed upload extensions, comma-separated.
# 默认 * 表示允许全部扩展名。/ Default * allows all extensions.
# 示例 / Example: .jpg,.jpeg,.png,.gif,.pdf
UPLOAD_TYPES=*

# 单个上传文件大小上限，单位：字节。
# Maximum size of one uploaded file, in bytes.
# 默认 1048576 字节 = 1 MiB。/ Default: 1048576 bytes = 1 MiB.
MAX_UPLOAD_SIZE=1048576

# IP 白名单，多个 IP 使用英文逗号分隔。
# IP whitelist, comma-separated.
# 上传接口和静态资源接口都会验证。
# Applied to both upload and static-resource requests.
# 留空表示不限制 IP。/ Empty means no IP restriction.
# 示例 / Example: 127.0.0.1,192.168.1.10,10.0.0.8
IP_WHITELIST=

# 资源根目录。
# Resource root directory.
# 留空默认：可执行文件所在目录/res
# Empty default: <executable-directory>/res
# 相对路径以可执行文件所在目录为基准。
# Relative paths are resolved from the executable directory.
RES_ROOT=

# 是否信任反向代理传来的客户端 IP。
# Whether to trust client-IP headers from a reverse proxy.
# 默认 false，仅在你控制的可信代理后开启。
# Default: false. Enable only behind a trusted proxy you control.
TRUST_PROXY=false
