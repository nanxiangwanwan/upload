# ==========================================
# upload 配置文件 / Configuration file
# ==========================================

# HTTP 监听地址，默认 :8080。
ADDR=:8080

# 上传接口路径，默认 /upload。
# Upload endpoint path. Default: /upload.
UPLOAD_PATH=/upload

# 是否要求 RESTYPE 和 RESSIZE 必须同时携带。
# true: both RESTYPE and RESSIZE are required.
# false: both are optional; when provided they override the defaults below.
REQUIRE_TYPE_SIZE=false

# MD5 签名密钥【必填】。
# Upload signature:
#   RESSIGN = md5(MD5_KEY + RESTIME + RESTYPE + RESSIZE)
# RESTYPE/RESSIZE 为空时按空字符串参与拼接。
#
# Resource signature remains unchanged:
#   RESSIGN = md5(MD5_KEY + RESTIME + data)
# If query contains path:
#   RESSIGN = md5(MD5_KEY + RESTIME + data + resource_path)
MD5_KEY=请修改为你的密钥

# 上传请求时间允许误差，单位秒。
TIME_EXPIRE=300

# 默认允许上传的文件扩展名。
# RESTYPE 非空时，本次上传由 RESTYPE 覆盖此配置。
# Example: .jpg,.jpeg,.png,.gif,.pdf
UPLOAD_TYPES=*

# 默认单个文件最大字节数。
# RESSIZE 非空时，本次上传由 RESSIZE 覆盖此配置。
MAX_UPLOAD_SIZE=1048576

# 上传接口 IP 白名单，逗号分隔；留空表示不限制。
IP_WHITELIST=

# 是否信任反向代理客户端 IP 头。
TRUST_PROXY=false
